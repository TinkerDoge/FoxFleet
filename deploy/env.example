# ~/.config/foxfleet/env  (mode 600). Everything is optional.
# Bind address. Loopback by default; put a reverse proxy or Cloudflare Tunnel in front for public access.
FOXFLEET_HOST=127.0.0.1
PORT=3080
# Public origin(s) the browser/app will use, comma-separated (needed behind a proxy/tunnel for the CSRF/Origin check).
FOXFLEET_TRUSTED_ORIGINS=https://hub.example.com
# Optional: create the first owner from a password instead of the setup code (remove after first sign-in).
# FOXFLEET_PASSWORD=
# Where the built web app lives (default: web/dist next to server/).
# FOXFLEET_WEB_DIR=
# Bot API (experimental, default off). See docs/BOT-API-ROLLOUT.md before enabling in production.
# FOXFLEET_BOT_API=1
# Required with FOXFLEET_BOT_API=1: agent names allowed on the bot API (comma-separated, "*" = all).
# Unset or empty = NO bot agent (deny by default; the hub warns at start).
# FOXFLEET_BOT_AGENTS=sumi-native
