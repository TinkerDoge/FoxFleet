{
 "openapi": "3.1.0",
 "info": {
  "title": "Foxfleet hub API",
  "version": "0.2.0",
  "description": "The contract shared by the hub, the web app and the Android app. Contract tests (contract/run.mjs) run against the real hub and the web mock hub.",
  "license": {
   "name": "MIT",
   "identifier": "MIT"
  }
 },
 "servers": [
  {
   "url": "https://hub.example.com",
   "description": "Your hub; clients ask for the address on first launch"
  }
 ],
 "security": [
  {
   "session": []
  }
 ],
 "paths": {
  "/health": {
   "get": {
    "operationId": "health",
    "summary": "Liveness",
    "tags": [
     "system"
    ],
    "responses": {
     "200": {
      "description": "Alive",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "ok"
         ],
         "properties": {
          "ok": {
           "type": "boolean"
          }
         }
        }
       }
      }
     }
    },
    "security": []
   }
  },
  "/api/auth": {
   "get": {
    "operationId": "getAuth",
    "summary": "Who am I, and does this hub need setup? Safe to call unauthenticated (also the hub-address probe).",
    "tags": [
     "auth"
    ],
    "responses": {
     "200": {
      "description": "Auth state",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AuthInfo"
        }
       }
      }
     }
    },
    "security": []
   }
  },
  "/api/auth/setup": {
   "post": {
    "operationId": "setup",
    "summary": "First-run owner creation (only while setupRequired).",
    "tags": [
     "auth"
